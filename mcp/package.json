{
  "name": "horizon-pulse-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local stdio MCP server that exposes every live Horizon Pulse paid route (horizonpulse.dev) as a tool and pays the x402 v2 challenge (USDC on Base) from a buyer wallet you configure, with per-call and per-session spend caps.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "horizon-pulse-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node test/unpaid-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "viem": "2.56.7"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
