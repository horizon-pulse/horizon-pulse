# x402 / Base mainnet
X402_NETWORK=base
PAY_TO=0x5b32c973596078a967562ca652761404f19be0e9

# Coinbase CDP facilitator (required for verify + settle on mainnet)
# Create keys at https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
# PKCS8 PEM secret — use \n for newlines in single-line env, or multiline in Vercel
CDP_API_KEY_SECRET=

# Optional public RPCs for /status treasury balance, /api/portfolio, /api/gas
# Defaults prefer publicnode + drpc failover (mainnet.base.org often rate-limits)
# BASE_RPC_URL=https://base.publicnode.com
# ETH_RPC_URL=https://ethereum.publicnode.com

# Solana USDC rail (x402 `exact` on Solana mainnet via PayAI). OFF unless BOTH are set exactly.
# HP_SOLANA_PAYTO must equal the pinned payTo in lib/solana-config.ts character for character
# (Michael's Ledger address); any other value keeps the rail OFF. Go-live = Odin review gate.
# HP_SOLANA_ENABLED=true
# HP_SOLANA_PAYTO=BjY98A6dS3GGLZdz2zHy8wK7XAwnQgNhCc66mfmBTRPz
# HP_SOLANA_INIT_TIMEOUT_MS=2500
# Read-only RPC for the payTo USDC token-account check: https, allow-listed host only
# (lib/solana-config.ts SOLANA_RPC_HOST_ALLOWLIST; no IP/localhost/userinfo/port)
# HP_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# XRPL RLUSD rail (x402 `exact` on the XRP Ledger). OFF unless BOTH are set exactly.
# HP_XRPL_PAYTO must equal the pinned payTo in lib/xrpl-config.ts character for character
# (Michael's Ledger r-address, UNACTIVATED on mainnet as of 2026-10-08: the entry stays
# hidden until the account exists with an RLUSD trust line). Go-live = Odin review gate.
# HP_XRPL_ENABLED=true
# HP_XRPL_PAYTO must be the payTo pinned for the chosen network: xrpl:1 → rs2cF8jYDp4D7Ny2SrNV21xkNJRp3HiVTJ (throwaway testnet), xrpl:0 → r3FbirL83RAB2CwnUdxE5pCohMkuo6LQcf
# HP_XRPL_PAYTO=rs2cF8jYDp4D7Ny2SrNV21xkNJRp3HiVTJ
# Network: xrpl:1 (testnet, default, x402.org facilitator) or xrpl:0 (mainnet, facilitator REQUIRED)
# HP_XRPL_NETWORK=xrpl:1
# Facilitator: allow-listed per network (lib/xrpl-config.ts XRPL_FACILITATOR_ALLOWLIST)
# HP_XRPL_FACILITATOR_URL=https://x402.org/facilitator
# Read-only RPC (payTo readiness + settled-tx time): https, allow-listed host for the network
# HP_XRPL_RPC_URL=https://testnet.xrpl-labs.com/
# HP_XRPL_ASSET_TRANSFER_METHOD=sequence
# HP_XRPL_INIT_TIMEOUT_MS=2500

# XRPL replay store (optional). If both are set, duplicate-payment claims are shared across instances via Upstash Redis REST; otherwise per-instance memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
