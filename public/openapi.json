{
  "openapi": "3.0.3",
  "info": {
    "title": "Horizon Pulse",
    "description": "Pay-per-call APIs for AI agents via x402 v2 on Base USDC. Six crypto routes frozen; non-crypto LIVE: /api/fetch ($0.02 clean-text), /api/http ($0.01 universal proxy), /api/extract ($0.015 structured HTML).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://horizonpulse.dev",
      "description": "Canonical custom domain"
    },
    {
      "url": "https://horizon-pulse-seven.vercel.app",
      "description": "Vercel backup / fallback"
    }
  ],
  "paths": {
