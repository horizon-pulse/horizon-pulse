    },
    "/api/portfolio": {
      "get": {
        "summary": "Base + Ethereum portfolio risk snapshot",
        "description": "x402 v2 exact payment. Requires query param address=0x\u2026 Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.04 USDC (40000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9.",
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$"
            },
            "description": "EVM address (0x + 40 hex)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paid success \u2014 live portfolio JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          }
        }
      }
    },
    "/api/gas": {
      "get": {
        "summary": "Base + Ethereum gas fee snapshot",
        "description": "x402 v2 exact payment. Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.01 USDC (10000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9.",
        "responses": {
          "200": {
            "description": "Paid success \u2014 live gas JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          }
        }
      }
    },
    "/api/funding": {
      "get": {
        "summary": "OKX BTC/ETH/SOL perpetual funding",
        "description": "x402 v2 exact payment. Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.01 USDC (10000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9.",
        "responses": {
          "200": {
            "description": "Paid success \u2014 live funding JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          }
        }
      }
    },
    "/api/fetch": {
      "get": {
        "summary": "Fetch public URL \u2192 clean text/markdown",
        "description": "x402 v2 exact payment. Requires query param url=https://\u2026 Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.02 USDC (20000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9. SSRF-safe; ~200KB / 8s caps; preferred Content-Types: text/html, text/plain, application/json, text/markdown.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Absolute http(s) URL to fetch (private/localhost blocked)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paid success \u2014 cleaned text/markdown JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          },
          "400": {
            "description": "Bad or blocked URL"
          },
          "413": {
            "description": "Upstream body too large"
          },
          "415": {
            "description": "Unsupported Content-Type"
          },
          "502": {
            "description": "Upstream error"
          },
          "504": {
            "description": "Upstream timeout"
          }
        }
      }
    },
    "/api/http": {
      "get": {
        "summary": "Universal HTTP proxy (query)",
        "description": "x402 v2 exact payment. Requires query param url=https://\u2026. Optional method (GET default), headers (JSON string). Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.01 USDC (10000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9. SSRF-safe; ~384KB / 12s caps. Response: ok, status, headers, body, bodyEncoding, contentType, elapsedMs.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Absolute http(s) URL (private/localhost blocked)"
          },
          {
            "name": "method",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "HEAD",
                "PUT",
                "PATCH",
                "DELETE"
              ],
              "default": "GET"
            }
          },
          {
            "name": "headers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional JSON object string of allowlisted outbound headers"
          }
        ],
        "responses": {
          "200": {
            "description": "Paid success \u2014 proxied response JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          },
          "400": {
            "description": "Bad or blocked URL / method / headers"
          },
          "413": {
            "description": "Request or upstream body too large"
          },
          "502": {
            "description": "Upstream error"
          },
          "504": {
            "description": "Upstream timeout"
          }
        }
      },
      "post": {
        "summary": "Universal HTTP proxy (JSON body)",
        "description": "Same $0.01 USDC x402 price as GET. JSON body: { url, method?, headers?, body? }. body allowed for POST/PUT/PATCH upstream. Same SSRF/caps/payTo as GET.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "HEAD",
                      "PUT",
                      "PATCH",
                      "DELETE"
                    ]
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "body": {
                    "description": "String or JSON value (stringified) for POST/PUT/PATCH"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid success \u2014 proxied response JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          },
          "400": {
            "description": "Bad input / blocked target"
          },
          "413": {
            "description": "Body too large"
          },
          "502": {
            "description": "Upstream error"
          },
          "504": {
            "description": "Upstream timeout"
          }
        }
      }
    },
    "/api/extract": {
      "get": {
        "summary": "Extract structured fields from a public URL",
        "description": "x402 v2 exact payment. Query param url=https://\u2026 (optional if html provided via POST). Unpaid \u2192 HTTP 402 + PAYMENT-REQUIRED. Price $0.015 USDC (15000 atomic). Network eip155:8453. payTo 0x5b32c973596078a967562ca652761404f19be0e9. SSRF-safe; ~200KB / 8s caps. Response omits empty fields: ok, url?, title, description, canonical, language?, links, images, jsonLd, headings, textSample, elapsedMs.",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Absolute http(s) URL to fetch and extract (private/localhost blocked). Required on GET unless using POST with html."
          }
        ],
        "responses": {
          "200": {
            "description": "Paid success \u2014 structured extract JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          },
          "400": {
            "description": "Missing input / bad HTML"
          },
          "413": {
            "description": "HTML or body too large"
          },
          "415": {
            "description": "Upstream Content-Type is not HTML"
          },
          "502": {
            "description": "Upstream error"
          },
          "504": {
            "description": "Upstream timeout"
          }
        }
      },
      "post": {
        "summary": "Extract structured fields from URL and/or HTML",
        "description": "Same $0.015 USDC x402 price as GET. JSON body: { url?, html? } \u2014 at least one required. If html is provided it is parsed (url echoed); else url is fetched SSRF-safe. Same caps/payTo as GET. Network eip155:8453.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "html": {
                    "type": "string",
                    "description": "Raw HTML to parse (size-capped ~200KB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid success \u2014 structured extract JSON"
          },
          "402": {
            "description": "Payment Required (x402 v2)"
          },
          "400": {
            "description": "Missing input / bad HTML"
          },
          "413": {
            "description": "Body or HTML too large"
          },
          "502": {
            "description": "Upstream error"
          },
          "504": {
            "description": "Upstream timeout"
          }
        }
      }
    }
  }
}
